BOT_RATE_LIMIT_WINDOW_SECONDS=60
BOT_SEARCH_INFLIGHT_LIMIT_ENABLED=true
BOT_SEARCH_RATE_LIMIT_MAX_EVENTS=12
BOT_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
BOT_AI_RATE_LIMIT_MAX_EVENTS=12
BOT_AI_RATE_LIMIT_WINDOW_SECONDS=3600
BOT_SEARCH_BACKFILL_ENABLED=true
