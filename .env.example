DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,server
# Empty DATABASE_URL keeps direct local Python runs on SQLite.
# Docker Compose overrides empty DATABASE_URL to PostgreSQL automatically.
DATABASE_URL=

BOT_API_KEY=change-me-bot-key
PARSER_API_KEY=change-me-parser-key
SERVER_API_BASE_URL=http://127.0.0.1:8000/api
BOT_PUBLIC_BASE_URL=
ANALYTICS_API_KEY=
SITE_PORT=3000
SITE_ADMIN_USERNAME=admin
SITE_ADMIN_PASSWORD=admin
SITE_ADMIN_TELEGRAM_IDS=976835256
SITE_AUTH_SECRET=change-me-site-auth-secret
SITE_AUTH_SESSION_TTL_SECONDS=43200
SITE_AUTH_CODE_TTL_SECONDS=600
BOT_PRODUCT_SEARCH_LIMIT=10
BOT_SPONSORED_SEARCH_LIMIT=1
BOT_SERVER_API_TIMEOUT=10
# Values below 60 are raised to 60 seconds by the bot.
BOT_SEARCH_TIMEOUT_SECONDS=60
# Starts AI query rescue inside the 60-second search window. Set 0 to disable.
BOT_SEARCH_AI_RESCUE_AFTER_SECONDS=30
BOT_GUEST_SEARCH_ENABLED=true
BOT_CONSENT_ENABLED=true
BOT_CONSENT_VERSION=2026-06-consent-v3
