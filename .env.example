DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,server
# Empty DATABASE_URL keeps direct local Python runs on SQLite.
# Docker Compose overrides empty DATABASE_URL to PostgreSQL automatically.
DATABASE_URL=

BOT_API_KEY=change-me-bot-key
PARSER_API_KEY=change-me-parser-key
SERVER_API_BASE_URL=http://127.0.0.1:8000/api
BOT_PUBLIC_BASE_URL=
ANALYTICS_API_KEY=
SITE_PORT=3000
BOT_PRODUCT_SEARCH_LIMIT=5
BOT_SERVER_API_TIMEOUT=10
BOT_GUEST_SEARCH_ENABLED=true
BOT_CONSENT_ENABLED=true
BOT_CONSENT_VERSION=2026-06-consent-v1
# Leave empty to use BOT_PUBLIC_BASE_URL + /legal/privacy/ and /legal/sponsored-ads/.
BOT_PRIVACY_POLICY_URL=
BOT_SPONSORED_ADS_POLICY_URL=
USER_CONSENT_VERSION=2026-06-consent-v1
BOT_ANALYTICS_ENABLED=true
BOT_ANALYTICS_TIMEOUT=2
ANALYTICS_COOKIE_ENABLED=false
ANALYTICS_COOKIE_NAME=izlaber_cid
ANALYTICS_COOKIE_MAX_AGE_DAYS=180
ANALYTICS_HASH_IP=false
ANALYTICS_IP_HASH_SALT=
OPENAI_API_KEY=
OPENAI_RERANK_ENABLED=true
OPENAI_RERANK_MODEL=gpt-5.4-nano
OPENAI_RERANK_CANDIDATE_LIMIT=30
OPENAI_RERANK_TIMEOUT=8
OPENAI_RERANK_MAX_OUTPUT_TOKENS=900
OPENAI_SEARCH_EXPAND_ENABLED=true
OPENAI_SEARCH_EXPAND_MAX_QUERIES=3
OPENAI_SEARCH_EXPAND_QUERY_LIMIT=15
OPENAI_RERANK_MAX_PRODUCTS=80
OPENAI_RERANK_FALLBACK_ONLY=true
OPENAI_PHOTO_SEARCH_ENABLED=true
OPENAI_PHOTO_MODEL=gpt-5.4-nano
OPENAI_PHOTO_TIMEOUT=12
OPENAI_PHOTO_MAX_OUTPUT_TOKENS=500
OPENAI_PHOTO_DETAIL=high
OPENAI_PHOTO_MAX_PIXELS=1048576
OPENAI_PHOTO_MAX_DOWNLOAD_BYTES=2000000
OPENAI_PHOTO_CANDIDATE_LIMIT=60
OPENAI_PHOTO_VISUAL_RERANK_ENABLED=true
OPENAI_PHOTO_VISUAL_RERANK_LIMIT=16
OPENAI_PHOTO_VISUAL_RERANK_MIN_SCORE=55
PHOTO_VISUAL_MATCH_ENABLED=true
PHOTO_VISUAL_MATCH_MAX_DISTANCE=10
OPENAI_PHOTO_TEXT_FALLBACK_ENABLED=false
OPENAI_VOICE_SEARCH_ENABLED=true
OPENAI_VOICE_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE_TIMEOUT=20
OPENAI_VOICE_MAX_DOWNLOAD_BYTES=8000000
OPENAI_VOICE_MAX_DURATION_SECONDS=180
OPENAI_STATUS_NOTIFY_USER_ID=976835256
OPENAI_ADMIN_API_KEY=
OPENAI_MONTHLY_BUDGET_USD=
OPENAI_BALANCE_PROBE_INTERVAL=60
OPENAI_STARTUP_PROBE_ENABLED=true

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
BOT_PARSE_MODE=HTML
LOG_LEVEL=INFO

UZUM_CRAWL_DELAY_SECONDS=1.5
UZUM_MAX_RETRIES=3
UZUM_BATCH_SIZE=50
UZUM_DELTA_COMPARE_BATCH_SIZE=1000
UZUM_REQUEST_TIMEOUT=20
UZUM_AUDIT_AFTER=true
