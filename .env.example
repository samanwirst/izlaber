BOT_PRIVACY_POLICY_URL=
BOT_SPONSORED_ADS_POLICY_URL=
USER_CONSENT_VERSION=2026-06-consent-v3
BOT_ANALYTICS_ENABLED=true
BOT_ANALYTICS_TIMEOUT=2
BOT_RATE_LIMIT_ENABLED=true
BOT_RATE_LIMIT_ADMIN_BYPASS=true
