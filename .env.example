DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,server
DATABASE_URL=

BOT_API_KEY=change-me-bot-key
PARSER_API_KEY=change-me-parser-key
SERVER_API_BASE_URL=http://127.0.0.1:8000/api
BOT_PRODUCT_SEARCH_LIMIT=5
BOT_SERVER_API_TIMEOUT=10

TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token
BOT_PARSE_MODE=HTML
LOG_LEVEL=INFO

UZUM_CRAWL_DELAY_SECONDS=1.5
UZUM_MAX_RETRIES=3
UZUM_BATCH_SIZE=50
UZUM_DELTA_COMPARE_BATCH_SIZE=1000
UZUM_REQUEST_TIMEOUT=20
UZUM_AUDIT_AFTER=true
